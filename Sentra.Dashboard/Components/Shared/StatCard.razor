<div class="card">
    <div class="stat-label">@Label</div>
    <div class="stat-value" style="@(ValueColor is null ? null : $"color:{ValueColor}")">@Value</div>
    @if (Sub is not null)
    {
        <div class="stat-sub">@Sub</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter, EditorRequired] public required string Value { get; set; }
    [Parameter] public RenderFragment? Sub { get; set; }
    [Parameter] public string? ValueColor { get; set; }
}
